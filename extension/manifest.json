{
  "manifest_version": 3,
  "name": "CareerMatrix",
  "description": "AI-Powered Career Intelligence & Decision System：采集岗位并提供可解释的职业决策支持。",
  "version": "0.1.2",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerMatrix"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J",
        "windows": "Alt+J"
      },
      "description": "打开 CareerMatrix"
    }
  }
}
