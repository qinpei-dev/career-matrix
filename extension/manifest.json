{
  "manifest_version": 3,
  "name": "CareerMatrix",
  "description": "AI-Powered Career Intelligence & Decision System：采集岗位并提供可解释的职业决策支持。",
  "version": "0.1.5",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://www.zhipin.com/*"
  ],
  "action": {
    "default_title": "CareerMatrix"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J",
        "windows": "Alt+J"
      },
      "description": "打开 CareerMatrix"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*"
      ],
      "js": [
        "boss.js",
        "floating.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
